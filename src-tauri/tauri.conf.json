{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShiftConvert",
  "version": "0.3.0",
  "identifier": "com.shiftconvert.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ShiftConvert",
        "width": 500,
        "height": 360,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "maximizable": false,
        "minimizable": false,
        "closable": true,
        "dragDropEnabled": false,
        "backgroundColor": "#00000000",
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ws://localhost:*;"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Gabriel Bastarz",
    "homepage": "https://github.com/gabriel-bastarz/shiftconvert",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/ffmpeg/ffmpeg.exe": "ffmpeg/ffmpeg.exe",
      "resources/ffmpeg/LICENSE": "ffmpeg/LICENSE",
      "resources/ffmpeg/README.txt": "ffmpeg/README.txt",
      "resources/ffmpeg/SOURCE.txt": "ffmpeg/SOURCE.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerHooks": "installer/hooks.nsh",
        "startMenuFolder": "ShiftConvert"
      }
    }
  }
}
